# =============================================================
# PLanalyst — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================

# --- Data Source API Keys ---
FOOTBALL_DATA_API_KEY=your_football_data_org_api_key_here
# Free key: https://open-platform.theguardian.com/access/ (GDELT, the second news source, needs none)
GUARDIAN_API_KEY=your_guardian_api_key_here

# --- PostgreSQL Connection ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=planalyst
POSTGRES_USER=planalyst
POSTGRES_PASSWORD=planalyst_dev

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Season Configuration ---
PL_SEASON=2026
PL_SEASON_START_DATE=2026-08-15

# --- Optional behaviour ---
# Comma-separated browser origins allowed to call the API (default: the local dashboard)
# PLANALYST_CORS_ORIGINS=http://localhost:8501
# Where the dashboard finds the API
# PLANALYST_API_URL=http://localhost:8000
# Set to false to only warn (instead of stopping the pipeline) when dbt tests fail
# PLANALYST_DBT_TESTS_FATAL=true
