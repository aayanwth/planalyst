# =============================================================
# PLanalyst — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================

# --- Data Source API Keys ---
FOOTBALL_DATA_API_KEY=your_football_data_org_api_key_here
NEWS_API_KEY=your_newsapi_org_api_key_here

# --- PostgreSQL Connection ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=planalyst
POSTGRES_USER=planalyst
POSTGRES_PASSWORD=planalyst_dev

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Season Configuration ---
PL_SEASON=2026
PL_SEASON_START_DATE=2026-08-15
